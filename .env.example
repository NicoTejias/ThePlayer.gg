# MercadoPago Credentials - EXAMPLE
# Copy this file to .env.local and fill in your actual credentials

# Public Key (used in frontend)
VITE_MERCADOPAGO_PUBLIC_KEY=TEST-your-public-key-here

# Access Token (used in backend/Edge Functions)  
VITE_MERCADOPAGO_ACCESS_TOKEN=TEST-your-access-token-here

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
