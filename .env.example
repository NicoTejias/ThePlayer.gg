# =============================================================================
# VARIABLES DE ENTORNO - ThePlayer.gg
# =============================================================================
# Copia este archivo como .env.local y completa con tus valores reales
# NUNCA subas .env.local a Git
# =============================================================================

# Supabase Configuration
# ----------------------
# URL de tu proyecto Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave ANON (pública, segura para exponer en frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ NUNCA expongas esta clave en el frontend
# Solo para uso en backend/scripts de administración
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OAuth Configuration (opcional)
# ------------------------------
# Google OAuth Client ID (público, OK exponer)
VITE_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# YouTube API Key (público, OK exponer con restricciones)
VITE_YOUTUBE_API_KEY=AIzaSyD...

# Application Settings
# --------------------
# Entorno de ejecución
VITE_APP_ENV=development  # development | staging | production

# URL base de la aplicación
VITE_APP_URL=http://localhost:5173

# Analytics (opcional)
# --------------------
# Google Analytics ID
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry DSN para error tracking
VITE_SENTRY_DSN=https://...@sentry.io/...

# Feature Flags (opcional)
# -------------------------
VITE_ENABLE_MARKETPLACE=true
VITE_ENABLE_LIVE_STREAMS=true
VITE_ENABLE_JUDGE_SYSTEM=true

# =============================================================================
# NOTAS DE SEGURIDAD:
# =============================================================================
# 1. Prefija con VITE_ solo las variables que necesites en el frontend
# 2. Variables sin VITE_ NO estarán disponibles en el código del cliente
# 3. Agrega .env.local a .gitignore
# 4. Usa diferentes valores para dev/staging/production
# 5. Rota secretos cada 6 meses
# =============================================================================
